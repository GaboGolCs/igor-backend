{
  "compilerOptions": {
    /* Lenguaje y Entorno */
    "target": "ES2022",                                  
    "module": "NodeNext",                                
    "moduleResolution": "NodeNext",  
    "types": ["node"],                    
    
    /* Rutas y Directorios */
    "rootDir": "./src",                                  
    "outDir": "./dist",                                  
    
    /* Interoperabilidad y Modo Estricto */
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                      
    "skipLibCheck": true                                 
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "src/prisma/generated"]
}