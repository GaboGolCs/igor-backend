# Copiar a .env y completar. Las variables se validan al iniciar (src/infrastructure/config/env.ts).
# Formato: CLAVE=valor (sin espacios alrededor del "=", necesario para docker --env-file).

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de datos y Redis (docker compose up -d) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/igor_db
REDIS_URL=redis://127.0.0.1:6379

# --- Autenticación ---
# Obligatoria. Usar un valor largo y aleatorio en producción.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- Frontend ---
# Orígenes permitidos por CORS, separados por coma. Las apps nativas no lo necesitan.
CORS_ORIGINS=http://localhost:5173
# URL base del frontend: el correo de recuperación enlaza a ${FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:5173

# --- Producción / seguridad ---
# Número de proxies delante de la API (balanceador), o true/false
TRUST_PROXY=false
# Intentos por IP cada 15 minutos en login, forgot-password y reset-password
AUTH_RATE_LIMIT_MAX=10
# Swagger UI en /api/docs
API_DOCS_ENABLED=true

# --- Correo (obligatorio en producción) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Firebase Cloud Messaging (obligatorio en producción) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
